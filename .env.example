# Copy this file to .env and fill in your own values. Never commit .env.

# AWS credentials (needs access to Bedrock and S3 Vectors)
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key
AWS_DEFAULT_REGION=us-east-1

# S3 Vectors
VECTOR_BUCKET_NAME=smart-campus-assistant-vectors
VECTOR_INDEX_NAME=xyz-college-docs

# Bedrock models
ROUTER_MODEL_ID=us.amazon.nova-micro-v1:0
ANSWER_MODEL_ID=us.amazon.nova-lite-v1:0
EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0

# Optional: run the UI offline with a fake LLM and retriever
# SCA_DEMO_MODE=1

# Optional: email password reset codes over SMTP (STARTTLS). Leave unset for the
# demo, which shows the reset code on screen instead (demo only, never for real users).
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
